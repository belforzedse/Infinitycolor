{
  "name": "@repo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "typesVersions": {
    "*": {
      "commerce": ["src/types/commerce.ts"],
      "*": ["src/index.ts"]
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/api.ts",
    "./commerce": "./src/types/commerce.ts",
    "./client": "./src/client/api-client.ts",
    "./config": "./src/config/public.ts",
    "./cache": "./src/cache/api-cache.ts",
    "./token": "./src/token/access-token.ts",
    "./utils": "./src/utils/index.ts",
    "./fetch": "./src/fetch-with-timeout.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "20.17.30",
    "typescript": "7.0.2"
  }
}
