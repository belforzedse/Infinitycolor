{
  "name": "@repo/auth-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "dist-cjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist-cjs/browser.js",
      "default": "./dist/browser.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js",
      "require": "./dist-cjs/contracts.js",
      "default": "./dist/contracts.js"
    },
    "./redirects": {
      "types": "./dist/redirects.d.ts",
      "import": "./dist/redirects.js",
      "require": "./dist-cjs/redirects.js",
      "default": "./dist/redirects.js"
    },
    "./token-manager": {
      "types": "./dist/token-manager.d.ts",
      "import": "./dist/token-manager.js",
      "require": "./dist-cjs/token-manager.js",
      "default": "./dist/token-manager.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist-cjs/server.js",
      "default": "./dist/server.js"
    },
    "./bridge-signature": {
      "types": "./dist/bridge-signature.d.ts",
      "import": "./dist/bridge-signature.js",
      "require": "./dist-cjs/bridge-signature.js",
      "default": "./dist/bridge-signature.js"
    },
    "./birth-date": {
      "types": "./dist/birth-date.d.ts",
      "import": "./dist/birth-date.js",
      "require": "./dist-cjs/birth-date.js",
      "default": "./dist/birth-date.js"
    },
    "./admin-authorization": {
      "types": "./dist/admin-authorization.d.ts",
      "import": "./dist/admin-authorization.js",
      "require": "./dist-cjs/admin-authorization.js",
      "default": "./dist/admin-authorization.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build-cjs.json && node scripts/write-cjs-package.mjs",
    "check-types": "tsc --noEmit",
    "docs:check": "pnpm run build && node scripts/check-admin-authorization-doc.mjs",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "20.17.30",
    "typescript": "7.0.2"
  }
}
