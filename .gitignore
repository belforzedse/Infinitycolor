# Infinity Store Monorepo .gitignore

############################
# Dependencies
############################

node_modules/
.pnpm-store/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions



############################
# Environment Files
############################

.env
.env.local
.env.*.local
*.env
!*.env.example
main.env
dev.env
db.env

# Secrets
SECRETS_REFERENCE.txt

############################
# Build Outputs
############################

# Next.js
/.next/
/out/
apps/frontend/out/
apps/frontend/.next/
apps/frontend/.next-color-gallery-check/
apps/auth/.next/
apps/admin/.next/
apps/auth/out/
.turbo/

# Strapi
dist/
dist-cjs/
build/
.strapi/
.strapi-updater.json
.strapi-cloud.json
apps/backend/dist/
apps/backend/build/
apps/backend/.tmp/
apps/backend/src/extensions/documentation/documentation/

# Production
/build

############################
# Logs
############################

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/

############################
# OS Files
############################

.DS_Store
.AppleDouble
.LSOverride
Icon
.Spotlight-V100
.Trashes
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~

############################
# IDE
############################

.idea/
.vscode/
*.swp
*.swo
*.swn
*.swm

############################
# Testing
############################

coverage/
.nyc_output/
/coverage
# Jest JUnit output (jest-junit, written by test:ci in CI)
/reports/
apps/backend/junit.xml
apps/frontend/junit.xml
apps/e2e/playwright-report/
apps/e2e/test-results/
apps/e2e/.cache/
apps/e2e/e2e-admin-results.xml
apps/e2e/e2e-results.xml
apps/e2e/*-e2e-results.xml
apps/e2e/.auth/
apps/e2e/reports/
apps/e2e/blob-report/
apps/admin/coverage/
apps/admin/junit.xml
tmp/*
############################
# TypeScript
############################

*.tsbuildinfo
next-env.d.ts

############################
# Temporary Files
############################

*.tmp
temp/
.tmp

############################
# Python
############################

.venv/
apps/backend/scripts/orders-to-pdf/.venv/

############################
# Misc
############################

*.pid
*.seed
*.pid.lock
.vercel
ssl/
nbproject/
public/uploads/*
!public/uploads/.gitkeep
nul

# Generated files
apps/frontend/src/constants/build-version.json
apps/frontend/public/build-version.json
apps/frontend/public/sw-version.js

# Lock files (optional - uncomment to ignore)
# yarn.lock
# package-lock.json

############################
# Agent / tool scratch (keep out of git)
############################

.codex-*/
/.playwright-cli/
/output/
*.bak
__pycache__/

# Local development and generated artifacts
/outputs/
/artifacts/
/.tmp-chrome*/
**/__pycache__/
*.py[cod]
**/playwright-report/
**/test-results/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.venv/
**/node_modules/
**/.next/
!**/.env.example
!**/env.example
!**/*.env.example

# Personal agent overrides
.claude/settings.local.json

# Serialized local environment setup
/.dev-env-setup.lock/

# Local synthetic demo account (generated; never publish credentials)
.local-demo-credentials.json
.local-demo.lock/

# Generated by the Next.js development server
apps/frontend/AGENTS.md
