# Configuration example; copy to the matching ignored local file.
# Generate local secrets with node scripts/setup-dev-env.mjs (Node projects),
# or follow docs/development.md (Python projects).

# Custom admin (apps/admin). Copy to .env.local (gitignored).
# Backend (@repo/backend) and auth (@repo/auth) must be running before this app.

NEXT_PUBLIC_ADMIN_ENVIRONMENT=development
ADMIN_URL=http://localhost:2891
NEXT_PUBLIC_ADMIN_URL=http://localhost:2891
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:2888

# Admin proxies Strapi through its own /api/backend route rather than calling
# Strapi directly from the browser - point these at the admin origin itself,
# and set the real Strapi target via E2E_API_PROXY_TARGET below.
NEXT_PUBLIC_API_URL=http://localhost:2891/api/backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:2891/api/backend
NEXT_PUBLIC_IMAGE_BASE_URL=http://localhost:2891

# Central Better Auth (@repo/auth). Origins must be exact.
NEXT_PUBLIC_AUTH_ENVIRONMENT=development
NEXT_PUBLIC_AUTH_ORIGIN=http://localhost:2889
NEXT_PUBLIC_AUTH_URL=http://localhost:2889
AUTH_SERVER_ORIGIN=http://localhost:2889

# Server-side target the /api/backend proxy route forwards to.
E2E_API_PROXY_TARGET=http://127.0.0.1:1337
