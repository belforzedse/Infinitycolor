{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "indexes": [
    {
      "name": "idx_products_active_slug_lookup",
      "columns": [
        "slug"
      ]
    },
    {
      "name": "uq_products_external_source_id",
      "columns": [
        "external_source",
        "external_id"
      ],
      "type": "unique"
    },
    {
      "name": "idx_products_scheduled_publish",
      "columns": [
        "status",
        "scheduled_publish_at"
      ]
    },
    {
      "name": "idx_products_lifecycle_view",
      "columns": [
        "status",
        "removed_at",
        "last_edited_by_admin_at"
      ]
    },
    {
      "name": "idx_products_removed_at",
      "columns": [
        "removed_at"
      ]
    }
  ],
  "attributes": {
    "Title": {
      "type": "string",
      "required": true
    },
    "Slug": {
      "type": "string",
      "required": false,
      "unique": false
    },
    "Weight": {
      "type": "integer",
      "default": 100
    },
    "CoverImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "videos"
      ]
    },
    "Description": {
      "type": "richtext"
    },
    "Status": {
      "type": "enumeration",
      "enum": [
        "Active",
        "InActive",
        "Scheduled"
      ],
      "default": "InActive"
    },
    "scheduledPublishAt": {
      "type": "datetime"
    },
    "scheduledPublishTimezone": {
      "type": "string"
    },
    "scheduledPublishRequireMedia": {
      "type": "boolean",
      "default": false
    },
    "scheduledPublishRevision": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "scheduledPublishLastAttemptAt": {
      "type": "datetime"
    },
    "scheduledPublishLastError": {
      "type": "string"
    },
    "scheduledPublishFailureKind": {
      "type": "enumeration",
      "enum": [
        "Transient",
        "Permanent"
      ]
    },
    "scheduledPublishAttemptCount": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "scheduledPublishNextRetryAt": {
      "type": "datetime"
    },
    "scheduledPublishAuditContext": {
      "type": "json",
      "private": true
    },
    "publicationRevision": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "publicationEffectsCompletedRevision": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "publicationEffectsLastError": {
      "type": "string"
    },
    "ProductType": {
      "type": "enumeration",
      "enum": [
        "Variable",
        "Simple"
      ],
      "default": "Variable"
    },
    "IsSimpleProduct": {
      "type": "boolean",
      "default": false
    },
    "Media": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "videos"
      ]
    },
    "AverageRating": {
      "type": "decimal"
    },
    "RatingCount": {
      "type": "integer"
    },
    "SeenCount": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "product_main_category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product-category.product-category",
      "inversedBy": "products"
    },
    "product_reviews": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product-review.product-review",
      "mappedBy": "product"
    },
    "product_tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product-tag.product-tag",
      "mappedBy": "products"
    },
    "product_variations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product-variation.product-variation",
      "mappedBy": "product"
    },
    "product_attribute_assignments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product-attribute-assignment.product-attribute-assignment",
      "mappedBy": "product"
    },
    "owned_product_attributes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product-attribute.product-attribute",
      "mappedBy": "owner_product"
    },
    "Files": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "files"
      ]
    },
    "product_size_helper": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::product-size-helper.product-size-helper",
      "mappedBy": "product"
    },
    "CleaningTips": {
      "type": "text"
    },
    "ReturnConditions": {
      "type": "text"
    },
    "product_faqs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product-faq.product-faq",
      "mappedBy": "product"
    },
    "product_other_categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product-category.product-category",
      "inversedBy": "product_others"
    },
    "discounts": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::discount.discount",
      "mappedBy": "products"
    },
    "removedAt": {
      "type": "datetime"
    },
    "removedById": {
      "type": "integer"
    },
    "removedByLabel": {
      "type": "string"
    },
    "preRemovalStatus": {
      "type": "enumeration",
      "enum": [
        "Active",
        "InActive",
        "Scheduled"
      ]
    },
    "preRemovalScheduledPublishAt": {
      "type": "datetime"
    },
    "purgedAt": {
      "type": "datetime"
    },
    "purgedById": {
      "type": "integer"
    },
    "LastEditedByAdminAt": {
      "type": "datetime"
    },
    "PublishedAt": {
      "type": "datetime"
    },
    "external_id": {
      "type": "string",
      "unique": false
    },
    "external_source": {
      "type": "string"
    },
    "product_views": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product-view.product-view",
      "mappedBy": "product"
    },
    "slug_aliases": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product-slug-alias.product-slug-alias",
      "mappedBy": "product"
    },
    "EditRevision": {
      "type": "integer",
      "default": 0,
      "min": 0
    }
  }
}
