{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "indexes": [
    {
      "name": "uq_orders_external_source_id",
      "columns": ["external_source", "external_id"],
      "type": "unique"
    }
  ],
  "attributes": {
    "Description": {
      "type": "text"
    },
    "Note": {
      "type": "text"
    },
    "CancellationReason": {
      "type": "text"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "orders"
    },
    "contract": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::contract.contract",
      "inversedBy": "order"
    },
    "Status": {
      "type": "enumeration",
      "enum": ["Paying", "Started", "Shipment", "Done", "Returned", "Cancelled"],
      "default": "Paying"
    },
    "ReservationStatus": {
      "type": "enumeration",
      "enum": ["Reserved", "Released", "Consumed", "Expired"],
      "default": "Released"
    },
    "ReservedUntil": {
      "type": "datetime"
    },
    "Date": {
      "type": "datetime",
      "required": true
    },
    "order_items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::order-item.order-item",
      "mappedBy": "order"
    },
    "Type": {
      "type": "enumeration",
      "enum": ["Manual", "Automatic"],
      "default": "Automatic"
    },
    "shipping": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::shipping.shipping",
      "inversedBy": "orders"
    },
    "delivery_address": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::local-user-address.local-user-address"
    },
    "ShippingCost": {
      "type": "integer",
      "required": false,
      "min": 0,
      "default": 0
    },
    "ShippingMethodCode": {
      "type": "string"
    },
    "ShippingMethodTitle": {
      "type": "string"
    },
    "ShippingBarcode": {
      "type": "string"
    },
    "ShippingPostPrice": {
      "type": "integer",
      "min": 0,
      "default": 0
    },
    "ShippingTax": {
      "type": "integer",
      "min": 0,
      "default": 0
    },
    "ShippingWeight": {
      "type": "integer",
      "min": 0,
      "default": 0
    },
    "ShippingBoxSizeId": {
      "type": "integer",
      "min": 0,
      "default": 0
    },
    "AnipoBarcodeState": {
      "type": "enumeration",
      "enum": ["Pending", "Issued", "NeedsAttention", "Stopped", "Voided"]
    },
    "AnipoSubmittedAt": {
      "type": "datetime"
    },
    "AnipoLastCheckedAt": {
      "type": "datetime"
    },
    "AnipoPollingDeadlineAt": {
      "type": "datetime"
    },
    "AnipoIssuedAt": {
      "type": "datetime"
    },
    "AnipoCheckCount": {
      "type": "integer",
      "min": 0,
      "default": 0
    },
    "AnipoReadyToIssue": {
      "type": "boolean"
    },
    "AnipoProviderStatus": {
      "type": "string"
    },
    "AnipoLastMessage": {
      "type": "text"
    },
    "AnipoLastError": {
      "type": "text"
    },
    "AnipoRecipientRevision": {
      "type": "integer",
      "min": 0,
      "default": 0
    },
    "AnipoRecipientSyncedRevision": {
      "type": "integer",
      "min": 0,
      "default": 0
    },
    "AnipoRecipientSyncState": {
      "type": "enumeration",
      "enum": ["Pending", "Synced", "NeedsAttention"]
    },
    "AnipoRecipientSyncAttempts": {
      "type": "integer",
      "min": 0,
      "default": 0
    },
    "AnipoRecipientSyncLastAttemptAt": {
      "type": "datetime"
    },
    "AnipoRecipientSyncLastError": {
      "type": "text"
    },
    "AnipoRecipientSyncedAt": {
      "type": "datetime"
    },
    "external_id": {
      "type": "string",
      "unique": false
    },
    "external_source": {
      "type": "string"
    },
    "DiscountCode": {
      "type": "string"
    },
    "AppliedGeneralDiscountId": {
      "type": "integer"
    },
    "AppliedDiscountAmount": {
      "type": "integer",
      "min": 0,
      "default": 0
    },
    "DiscountUsageClaimedDiscountId": {
      "type": "integer"
    },
    "CartCleanupCompletedAt": {
      "type": "datetime"
    },
    "ManualStockAppliedAt": {
      "type": "datetime"
    },
    "PaymentGateway": {
      "type": "enumeration",
      "enum": ["Unknown", "Wallet", "Mellat", "SnappPay", "SamanKish", "ZarinPal", "Manual", "CardToCard", "Other"],
      "default": "Unknown"
    },
    "isReserveOrder": {
      "type": "boolean",
      "default": false
    },
    "reserveExpiresAt": {
      "type": "datetime"
    },
    "reserveGroupId": {
      "type": "string"
    },
    "reserve_shipment": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::reserve-group.reserve-group",
      "inversedBy": "orders"
    },
    "analytics_correlation_id": {
      "type": "string",
      "maxLength": 160
    }
  }
}
