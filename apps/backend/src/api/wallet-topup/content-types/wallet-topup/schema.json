{
  "kind": "collectionType",
  "collectionName": "wallet_topups",
  "info": {
    "singularName": "wallet-topup",
    "pluralName": "wallet-topups",
    "displayName": "WalletTopup"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "Amount": {
      "type": "biginteger",
      "required": true,
      "min": "0"
    },
    "Gateway": {
      "type": "enumeration",
      "enum": [
        "Mellat",
        "SamanKish",
        "ZarinPal"
      ],
      "default": "Mellat"
    },
    "Status": {
      "type": "enumeration",
      "enum": [
        "Pending",
        "Processing",
        "Unknown",
        "Success",
        "Failed",
        "Cancelled"
      ],
      "required": true,
      "default": "Pending"
    },
    "SaleOrderId": {
      "type": "string",
      "unique": true
    },
    "RefId": {
      "type": "string"
    },
    "SaleReferenceId": {
      "type": "string"
    },
    "ProviderReference": {
      "type": "string"
    },
    "VerificationReference": {
      "type": "string"
    },
    "ExpiresAt": {
      "type": "datetime"
    },
    "LedgerReferenceId": {
      "type": "string"
    },
    "IdempotencyKey": {
      "type": "string"
    },
    "RedirectUrl": {
      "type": "text"
    },
    "RedirectMethod": {
      "type": "enumeration",
      "enum": [
        "GET",
        "POST"
      ]
    },
    "NextReconcileAt": {
      "type": "datetime"
    },
    "ReconcileAttempts": {
      "type": "integer",
      "min": 0,
      "default": 0
    },
    "LastProviderCode": {
      "type": "integer"
    },
    "LastProviderError": {
      "type": "text"
    },
    "Note": {
      "type": "text"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "Date": {
      "type": "datetime"
    }
  }
}
