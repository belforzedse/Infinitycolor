{
  "kind": "collectionType",
  "collectionName": "payment_attempts",
  "info": {
    "singularName": "payment-attempt",
    "pluralName": "payment-attempts",
    "displayName": "Payment Attempt",
    "description": "Durable checkout and provider-payment attempt state"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "attemptId": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "quoteHash": {
      "type": "string",
      "required": true
    },
    "quoteSnapshot": {
      "type": "json",
      "required": true
    },
    "Status": {
      "type": "enumeration",
      "enum": [
        "Created",
        "Redirected",
        "Pending",
        "Succeeded",
        "Failed",
        "Cancelled",
        "Unknown",
        "Expired"
      ],
      "default": "Created",
      "required": true
    },
    "Gateway": {
      "type": "string",
      "required": true
    },
    "Amount": {
      "type": "biginteger",
      "required": true,
      "min": "0"
    },
    "WalletAmount": {
      "type": "biginteger",
      "min": "0"
    },
    "GatewayAmount": {
      "type": "biginteger",
      "min": "0"
    },
    "WalletHoldStatus": {
      "type": "enumeration",
      "enum": [
        "None",
        "DirectDebit",
        "Active",
        "Captured",
        "Released"
      ]
    },
    "WalletHeldAt": {
      "type": "datetime"
    },
    "WalletCapturedAt": {
      "type": "datetime"
    },
    "WalletReleasedAt": {
      "type": "datetime"
    },
    "WalletReleaseReason": {
      "type": "string"
    },
    "WalletLedgerReferenceId": {
      "type": "string"
    },
    "SupersedesAttemptId": {
      "type": "string"
    },
    "providerReference": {
      "type": "string"
    },
    "redirectUrl": {
      "type": "text"
    },
    "failureCode": {
      "type": "string"
    },
    "failureMessage": {
      "type": "text"
    },
    "providerResponse": {
      "type": "json"
    },
    "providerStatus": {
      "type": "string"
    },
    "nextAction": {
      "type": "string"
    },
    "nextActionAt": {
      "type": "datetime"
    },
    "leaseUntil": {
      "type": "datetime"
    },
    "leaseVersion": {
      "type": "integer",
      "default": 0
    },
    "callbackNonceHash": {
      "type": "string",
      "private": true
    },
    "callbackNonce": {
      "type": "string",
      "private": true
    },
    "sideEffectsCompletedAt": {
      "type": "datetime"
    },
    "redirectedAt": {
      "type": "datetime"
    },
    "resolvedAt": {
      "type": "datetime"
    },
    "lastReconciledAt": {
      "type": "datetime"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "order": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::order.order"
    },
    "contract": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::contract.contract"
    }
  }
}
