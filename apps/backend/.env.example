HOST=0.0.0.0
PORT=1337
# Trust reverse-proxy headers (X-Forwarded-For / X-Real-IP) so audit logs capture the real client
# IP instead of the nginx->Strapi hop. Keep true behind nginx; set false only if Strapi is exposed
# directly (otherwise clients could spoof these headers).
IS_PROXIED=true
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified

# Database Configuration
POSTGRES_IMAGE=postgres:16-alpine
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=infinity_db
DATABASE_USERNAME=strapi_user
DATABASE_PASSWORD=strapi_password
DATABASE_POOL_MIN=4
DATABASE_POOL_MAX=20
DATABASE_CONNECTION_TIMEOUT=30000

# Redis Configuration
REDIS_IMAGE=redis:7-alpine
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=redispass
REDIS_CACHE_DB=1
HEALTH_DEPENDENCY_TIMEOUT_MS=1500
REST_CACHE_PROVIDER=redis
REST_CACHE_REDIS_CONNECTION=default

# Issue-report ingestion. Limits are per authenticated user or trusted source IP;
# there is intentionally no global daily cap.
ISSUE_REPORT_USER_BURST=6
ISSUE_REPORT_USER_REFILL_SECONDS=300
ISSUE_REPORT_IP_BURST=20
ISSUE_REPORT_IP_REFILL_SECONDS=30
ISSUE_REPORT_MAX_IN_FLIGHT=3
ISSUE_REPORT_DB_TIMEOUT_MS=3000

# BullMQ queue Redis. Keep this separate from REDIS_URL because BullMQ requires noeviction.
PROCESS_ROLE=web
QUEUE_REDIS_URL=redis://localhost:6381
QUEUE_REDIS_PASSWORD=
QUEUE_REDIS_PORT=6381
QUEUE_PREFIX=bull:infinity
QUEUE_TIMEZONE=Asia/Tehran
WORKER_CONCURRENCY_COMMERCE=1
WORKER_CONCURRENCY_ANALYTICS=1
WORKER_CONCURRENCY_PAYMENTS=1
QUEUE_CRON_STOCK_RESERVATION_EXPIRY=*/1 * * * *
QUEUE_CRON_RESERVE_ORDER_EXPIRY=*/5 * * * *
QUEUE_CRON_VIEW_COUNTER_FLUSH=*/1 * * * *
QUEUE_CRON_WALLET_TOPUP_RECONCILE=*/1 * * * *
QUEUE_CRON_ANIPO_BARCODE_RECONCILE=*/15 * * * *
ANIPO_BARCODE_RECONCILE_ENABLED=true
ANIPO_BARCODE_RECONCILE_BATCH_SIZE=50
ANIPO_BARCODE_RECONCILE_CONCURRENCY=3
DISABLE_BACKGROUND_JOBS=false

# Stock reservations
# MUST stay above the longest gateway payment-session lifetime (currently
# SAMAN_TOKEN_EXPIRY_MIN=20). If a reservation expires while the customer can
# still pay, the expiry job releases the stock and the later successful charge
# has to be reversed.
STOCK_RESERVATION_TTL_MINUTES=30
STOCK_RESERVATION_EXPIRY_GRACE_SECONDS=60
# Hard ceiling on how long an unresolved SnappPay payment may keep deferring its
# reservation. Sits just past the ~40h reconciliation ladder.
SNAPPAY_RESERVATION_DEFER_MAX_HOURS=48
# After this long an unpaid (REGISTERED) SnappPay token is treated as an abandoned
# checkout and reverted automatically — no money was taken, so no operator review
# is needed. Defaults to STOCK_RESERVATION_TTL_MINUTES.
SNAPPAY_ABANDON_AFTER_MINUTES=30

# Endpoint response cache (conservative rollout)
ENABLE_ENDPOINT_RESPONSE_CACHE=true
CACHE_ONLY_ANONYMOUS=true
CACHE_TTL_PRODUCT_BY_SLUG_SEC=60
CACHE_TTL_PRODUCT_SEARCH_SEC=20
CACHE_TTL_BLOG_SLUG_SEC=120
CACHE_TTL_BLOG_COMMENTS_SEC=60
CACHE_DEBUG_HEADER=false

# Async view counters (eventual consistency)
ENABLE_ASYNC_VIEW_COUNTERS=true
VIEW_COUNTER_FLUSH_INTERVAL_MS=60000
VIEW_COUNTER_BUCKET_SEC=60

# SMS Gateway (IPPanel Edge API)
SMS_ENABLED=false
IP_PANEL_API_BASE_URL=https://edge.ippanel.com/v1
IP_PANEL_PATTERN_ENDPOINT=/api/send
# Optional full URL override for order notifications only. OTP uses a hardcoded legacy URL.
IP_PANEL_API_URL=
IP_PANEL_API_KEY=replace_me
IP_PANEL_PATTERN_CODE=replace_me
IP_PANEL_SENDER=+983000505
# Optional future per-event pattern overrides. Defaults fall back to IP_PANEL_PATTERN_CODE.
# IP_PANEL_PATTERN_OTP=replace_me
IP_PANEL_PATTERN_ORDER_CREATED=gbktfbujgkyonij
IP_PANEL_PATTERN_ORDER_STATUS_UPDATED=4l9ujcrfkid2cs9
IP_PANEL_PATTERN_SHIPPED=wvkng8k19kiv8jw
IP_PANEL_PATTERN_CANCELLED=7mcuh1o6qlcq335

# Payment Gateway - Mellat Bank (REQUIRED)
MELLAT_TERMINAL_ID=your_terminal_id
MELLAT_USERNAME=your_username
MELLAT_PASSWORD=your_password
MELLAT_GATEWAY_URL=https://bpm.shaparak.ir/pgwchannel/services/pgw
MELLAT_PAYMENT_URL=https://bpm.shaparak.ir/pgwchannel/startpay.mellat

# Payment Gateway - SnappPay (REQUIRED)
# No defaults exist for any of these: getSnappayConfig() throws
# SNAPPAY_CONFIG_INVALID:<name> when one is missing, so every environment must set
# them explicitly.
#
# Use the exact endpoint issued to you by SnappPay, and do not copy the values
# below into production. The canonical host spelling is `snapppay` (three p's);
# staging is issued as a snappcloud.io host, e.g.
#   https://fms-gateway-staging.apps.public.teh-1.snappcloud.io
# Must be HTTPS.
SNAPPAY_BASE_URL=
SNAPPAY_CLIENT_ID=your_client_id
SNAPPAY_CLIENT_SECRET=your_client_secret
SNAPPAY_USERNAME=your_username
SNAPPAY_PASSWORD=your_password
# Registered storefront POST return URL. Must use HTTPS, must point to
# /api/snapp/return, and must match the URL registered with SnappPay for THIS
# environment — a staging URL in production sends customers to the wrong host.
SNAPPAY_RETURN_URL=
# Enable only after egress-IP/return-URL registration and staging acceptance.
SNAPPAY_HARDENED_INITIATION_ENABLED=false
# Note: the SnappPay payment token is stored as-is in contract_transactions.TrackId.
# It is not usable without the OAuth credentials above, and operators need it
# verbatim for SnappPay support tickets.

# Payment Gateway - Saman Kish / SEP (REQUIRED for wallet top-ups)
SAMAN_GATEWAY_URL=https://sep.shaparak.ir/onlinepg/onlinepg
SAMAN_PAYMENT_PAGE_URL=https://sep.shaparak.ir/OnlinePG/OnlinePG
SAMAN_SEND_TOKEN_URL=https://sep.shaparak.ir/OnlinePG/SendToken
SAMAN_VERIFY_URL=https://sep.shaparak.ir/verifyTxnRandomSessionkey/ipg/VerifyTransaction
SAMAN_REVERSE_URL=https://sep.shaparak.ir/verifyTxnRandomSessionkey/ipg/ReverseTransaction
SAMAN_TERMINAL_ID=your_terminal_id
SAMAN_USERNAME=your_username
SAMAN_PASSWORD=your_password
SAMAN_CALLBACK_URL=https://api.infinitycolor.co/api/wallet/payment-callback
SAMAN_TOKEN_EXPIRY_MIN=20

# Payment Gateway - ZarinPal (optional; gateway only shown when MERCHANT_ID is set)
ZARINPAL_MERCHANT_ID=your_zarinpal_merchant_uuid
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=http://localhost:1337/api/orders/payment-callback
ZARINPAL_CURRENCY=IRR

# Storefront cache invalidation.
#
# REVALIDATION_SECRET is the bearer token Strapi presents to the storefront's
# /api/revalidate route; the same value must be set on the frontend.
REVALIDATION_SECRET=your_revalidation_secret_here

# Storefront origin(s) to notify on product/blog/settings changes. Comma-separated
# if a deployment genuinely fronts more than one storefront.
#
# Set this per environment. It must NEVER list another environment's storefront:
# these hostnames were previously hardcoded to both staging and production, so each
# environment invalidated the other's cache using its own bearer token.
# Falls back to FRONTEND_URL when unset.
NEXTJS_REVALIDATION_URL=http://localhost:2888

# Product slug repair (`pnpm repair:slugs -- --env production`).
# Dry-run by default; pass --confirm to write decoded canonical slugs and
# ProductSlugAlias rows for the prior percent-encoded forms.
# STRAPI_API_TOKEN_PRODUCTION=
# STRAPI_IMPORT_PRODUCTION_URL=https://api.infinitycolor.co/api
# STRAPI_API_TOKEN_STAGING=
# STRAPI_API_TOKEN_LOCAL=

# Umami Analytics (server-side report access + collector outbox)
UMAMI_BASE_URL=https://analytics.alpagency.net
UMAMI_WEBSITE_ID=00000000-0000-4000-8000-000000000001
UMAMI_WEBSITE_ALLOWLIST=00000000-0000-4000-8000-000000000001
# Prefer a short-lived reader login. UMAMI_API_TOKEN is accepted for managed API keys.
UMAMI_USERNAME=
UMAMI_PASSWORD=
UMAMI_API_TOKEN=
UMAMI_HOSTNAME=infinitycolor.co
UMAMI_DATA_START_DATE=2026-08-09
UMAMI_TIMEOUT_MS=8000
UMAMI_MAX_CONCURRENCY=6
QUEUE_CRON_ANALYTICS_OUTBOX_REPAIR=*/1 * * * *

# Sentry error tracking (optional - leave empty to disable)
SENTRY_DSN=
# Central Better Auth bridge and 60-second content-API JWT validation.
# Keep disabled until the additive auth migration and auth service are ready.
BETTER_AUTH_BRIDGE_ENABLED=false
BETTER_AUTH_ENVIRONMENT=development
AUTH_STRAPI_BRIDGE_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_JWKS_URL=http://localhost:2889/api/auth/jwks
BETTER_AUTH_JWT_ISSUER=http://localhost:2889
BETTER_AUTH_JWT_AUDIENCE=http://localhost:1337
BETTER_AUTH_JWT_CLOCK_TOLERANCE_SECONDS=5
# Compatibility window only; disabling later requires separate public-contract approval.
LEGACY_AUTH_JWT_ISSUANCE_ENABLED=true
# Historical bulk local_users -> plugin users migration. Keep false unless a
# separately reviewed data-migration run is explicitly approved.
LEGACY_LOCAL_USER_MIGRATION_ENABLED=false

# Anipo shipping (adminpnx web service) — Bearer token from store panel «وب‌سرویس»
ANIPO_TOKEN=
# Optional (defaults to https://adminpnx.anipo.ir/api/v1)
ANIPO_BASE_URL=https://adminpnx.anipo.ir/api/v1
