# Public static authority for the central authentication application.
AUTH_DEPLOYMENT_ENV=development
BETTER_AUTH_URL=http://localhost:2889
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Dedicated PostgreSQL login whose default privileges are limited to the auth schema.
AUTH_DATABASE_URL=postgresql://infinity_auth_app:replace-password@localhost:5432/infinitycolor
AUTH_FLOW_SECRET=replace-with-at-least-32-random-characters

# Comma-separated exact origins. 127.0.0.1 is intentionally not implied.
# 2888 storefront, 2890 Infinitygram. Staging and production ignore this list:
# their storefront origins are frozen in src/server/env.ts.
AUTH_TRUSTED_STOREFRONT_ORIGINS=http://localhost:2888,http://localhost:2890
AUTH_TRUSTED_ADMIN_ORIGINS=http://localhost:2891
AUTH_DEFAULT_STOREFRONT_ORIGIN=http://localhost:2888

# Server-to-server Strapi bridge.
STRAPI_INTERNAL_URL=http://localhost:1337
AUTH_STRAPI_BRIDGE_SECRET=replace-with-at-least-32-random-characters

# Frozen JWT and session policy.
AUTH_JWT_ISSUER=http://localhost:2889
AUTH_JWT_AUDIENCE=http://localhost:1337
AUTH_JWT_TTL_SECONDS=60
AUTH_JWKS_ROTATION_SECONDS=2592000
AUTH_JWKS_GRACE_SECONDS=86400
AUTH_SESSION_TTL_SECONDS=604800

# Sentry error tracking (optional - leave empty to disable). Runtime-only and
# read on the server/edge; there is no client-side DSN, so nothing is baked
# into the build. Do not reuse the frontend/admin DSNs - they belong to a
# different Sentry project.
SENTRY_DSN=
