{
  "name": "@repo/auth",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "next dev -p 2889",
    "build": "next build",
    "start": "next start -p 2889",
    "migrate:apply": "node scripts/apply-migration.mjs",
    "check-types": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "check:bundle-syntax": "node scripts/check-bundle-syntax.mjs"
  },
  "dependencies": {
    "@repo/auth-core": "workspace:*",
    "@repo/auth-ui": "workspace:*",
    "@repo/fonts": "workspace:*",
    "@repo/ui": "workspace:*",
    "@sentry/nextjs": "^10.51.0",
    "better-auth": "1.6.23",
    "clsx": "2.1.1",
    "next": "16.3.2",
    "pg": "8.8.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "acorn": "8.16.0",
    "@types/node": "20.17.30",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "auth": "1.6.23",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "tsx": "4.21.0",
    "typescript": "7.0.2"
  },
  "_browserslist_note": "Mirrors apps/frontend. Without this, Next/Turbopack uses its own modern default and emits a class static initialization block (Chromium 94 / Samsung Internet 17) into the eagerly-loaded app-router chunk. Samsung Internet 16 (Chromium 92) then fails to PARSE that chunk, hydration never runs, and the login form falls back to a native GET submit (`/auth?phone=...`) that never reaches Better Auth. Keep this list in sync with the storefront so the login page never has a narrower floor than the shop it guards.",
  "browserslist": [
    "chrome >= 87",
    "edge >= 88",
    "firefox >= 78",
    "safari >= 14",
    "ios_saf >= 14",
    "and_chr >= 87",
    "and_ff >= 79",
    "samsung >= 12",
    "opera >= 73",
    "not dead",
    "not IE 11",
    "not op_mini all"
  ]
}
