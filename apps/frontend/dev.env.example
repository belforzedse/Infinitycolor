# Configuration example; copy to the matching ignored local file.
# Generate local secrets with node scripts/setup-dev-env.mjs (Node projects),
# or follow docs/development.md (Python projects).

# Local storefront — copy to dev.env or .env.local (both gitignored)
# Strapi (@repo/backend) must be running on port 1337 before starting the frontend.

NEXT_PUBLIC_API_BASE_URL=http://localhost:1337/api
NEXT_PUBLIC_IMAGE_BASE_URL=http://localhost:1337/
# Do not place private Strapi credentials in browser-visible variables.
NEXT_PUBLIC_STRAPI_TOKEN=

# Optional: use the staging API instead of local Strapi
# NEXT_PUBLIC_API_BASE_URL=https://api.staging.infinitycolor.co/api
# NEXT_PUBLIC_IMAGE_BASE_URL=https://api.staging.infinitycolor.co/

# Optional: read-only against the production API
# NEXT_PUBLIC_API_BASE_URL=https://api.infinitycolor.co/api
# NEXT_PUBLIC_IMAGE_BASE_URL=https://api.infinitycolor.co/

# Server-side only (Docker production). Leave empty for local dev — and keep it
# empty when pointing the two vars above at staging/production, since
# getStrapiServerUrl() prefers it and would send server-side fetches elsewhere.
STRAPI_INTERNAL_URL=

# Optional private Umami development tracking. Keep the website id empty unless
# this browser session is intentionally allowed to send local telemetry.
NEXT_PUBLIC_UMAMI_URL=http://localhost:8093
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_ENABLE_DEV=false
