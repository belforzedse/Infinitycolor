# API Configuration — see dev.env.example for local storefront setup (Strapi on port 1337)
NEXT_PUBLIC_API_BASE_URL=http://localhost:1337/api
NEXT_PUBLIC_IMAGE_BASE_URL=http://localhost:1337/
# Optional CDN origin for Strapi /uploads media (e.g. https://cdn.infinitycolor.co).
# Leave empty for local development — uploads are served from NEXT_PUBLIC_IMAGE_BASE_URL.
# When set, /uploads URLs are rewritten to this origin. See docs/cdn-uploads.md.
NEXT_PUBLIC_MEDIA_CDN_URL=
# Server-side only. In Docker production this should point to the internal Nginx
# listener that proxies to strapi_upstream, e.g. http://host.docker.internal:8080/api
STRAPI_INTERNAL_URL=
# Server-side callback redirect allowlist (comma-separated origins).
NEXT_PUBLIC_ALLOWED_REDIRECT_ORIGINS=http://localhost:3000

# Central Better Auth. Origins must be exact; 127.0.0.1 is not implied.
NEXT_PUBLIC_AUTH_ENVIRONMENT=development
NEXT_PUBLIC_AUTH_ORIGIN=http://localhost:2889
AUTH_SERVER_ORIGIN=http://localhost:2889
CENTRAL_AUTH_CUTOVER_ENABLED=false

# SSG Configuration (0 to disable, number for limit)
NEXT_PUBLIC_MAX_BLOG_SSG=0
NEXT_PUBLIC_MAX_PDP_SSG=0

# Sentry/Bugsink Error Tracking (optional - leave empty to disable)
NEXT_PUBLIC_SENTRY_DSN=
# Matomo (matomo.alpagency.net): prod site id = 2, staging site id = 3.
# Leave both empty to disable tracking entirely — there is no fallback host/site,
# by design, so a missing value here never silently ships hits under the wrong
# site id (e.g. a staging build mixing traffic into the prod site).
NEXT_PUBLIC_MATOMO_URL=https://matomo.alpagency.net
NEXT_PUBLIC_MATOMO_SITE_ID=2

# Shared secret for the on-demand revalidation route (/api/revalidate).
# Must match REVALIDATION_SECRET on the Strapi backend, otherwise every
# product/blog invalidation is rejected with 403 and caches go stale silently.
REVALIDATION_SECRET=your_revalidation_secret_here

# Canonical public origin. Used for sitemap <loc> entries and canonical URLs.
NEXT_PUBLIC_SITE_URL=https://new.infinitycolor.co
