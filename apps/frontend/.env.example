# API Configuration — see dev.env.example for local storefront setup (Strapi on port 1337)
NEXT_PUBLIC_API_BASE_URL=http://localhost:1337/api
NEXT_PUBLIC_IMAGE_BASE_URL=http://localhost:1337/
# Optional CDN origin for Strapi /uploads media (e.g. https://cdn.infinitycolor.co).
# Leave empty for local development — uploads are served from NEXT_PUBLIC_IMAGE_BASE_URL.
# When set, /uploads URLs are rewritten to this origin. See docs/cdn-uploads.md.
NEXT_PUBLIC_MEDIA_CDN_URL=
# Server-side only. In Docker production this should point to the internal Nginx
# listener that proxies to strapi_upstream, e.g. http://host.docker.internal:8080/api
STRAPI_INTERNAL_URL=
# Server-side callback redirect allowlist (comma-separated origins).
NEXT_PUBLIC_ALLOWED_REDIRECT_ORIGINS=http://localhost:3000

# Central Better Auth. Origins must be exact; 127.0.0.1 is not implied.
NEXT_PUBLIC_AUTH_ENVIRONMENT=development
NEXT_PUBLIC_AUTH_ORIGIN=http://localhost:2889
AUTH_SERVER_ORIGIN=http://localhost:2889
CENTRAL_AUTH_CUTOVER_ENABLED=false

# SSG Configuration (0 to disable, number for limit)
NEXT_PUBLIC_MAX_BLOG_SSG=0

# PDP static generation covers every currently published product at build time —
# no cap (NEXT_PUBLIC_MAX_PDP_SSG previously documented a limit here but was never
# wired to any code path; removed rather than left as misleading dead config).
# A Strapi failure during generateStaticParams fails the build by default; set
# this to "false" to degrade to zero pre-rendered PDPs instead (ops escape hatch).
STATIC_PARAMS_FAIL_ON_INCOMPLETE=

# Sentry error tracking (optional - leave empty to disable)
NEXT_PUBLIC_SENTRY_DSN=
# Replay defaults to 100% sessions in staging and 1% in production, with 100%
# error sampling. Set these only for a deliberate per-environment override.
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=
# Private Umami (analytics.alpagency.net): website IDs are deployment values.
# Leave both empty to disable tracking entirely — there is no fallback host/site,
# by design, so a missing value here never silently ships hits under the wrong
# website (e.g. a staging build mixing traffic into production).
NEXT_PUBLIC_UMAMI_URL=https://analytics.alpagency.net
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Optional local/test opt-in; production tracking is enabled by default.
NEXT_PUBLIC_UMAMI_ENABLE_DEV=false

# Shared secret for the on-demand revalidation route (/api/revalidate).
# Must match REVALIDATION_SECRET on the Strapi backend, otherwise every
# product/blog invalidation is rejected with 403 and caches go stale silently.
REVALIDATION_SECRET=your_revalidation_secret_here

# Canonical public origin. Used for sitemap <loc> entries and canonical URLs.
NEXT_PUBLIC_SITE_URL=https://infinitycolor.co

# Reserve ("ارسال رزروی" / 48h) checkout option. Build-time; "false" hides the
# option and the storefront stops sending reserve fields (UI-only soft-lock).
NEXT_PUBLIC_INFINITY_RESERVE_CHECKOUT_ENABLED=true

# Wallet top-up controls. This is a UI-only build-time kill switch and defaults
# to off. Provider callbacks, verification, reconciliation, and status polling
# continue independently on the backend for payments already in flight.
NEXT_PUBLIC_WALLET_TOPUP_UI_ENABLED=false
