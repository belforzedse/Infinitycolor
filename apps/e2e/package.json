{
  "name": "@repo/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep \"@smoke\"",
    "e2e:regression": "playwright test --grep \"@regression\"",
    "e2e:payment": "playwright test --grep \"@payment\" --grep-invert \"@payment-live\"",
    "e2e:payment:live": "playwright test --grep \"@payment-live\"",
    "e2e:adaptive": "playwright test --config adaptive.playwright.config.ts",
    "e2e:adaptive:parity": "playwright test --config static-parity.playwright.config.ts",
    "e2e:adaptive:lowest": "playwright test --config forced-low.playwright.config.ts",
    "e2e:instant": "playwright test --config instant.playwright.config.ts",
    "e2e:admin": "playwright test --config admin.playwright.config.ts",
    "e2e:admin:smoke": "playwright test --config admin.playwright.config.ts --grep \"@smoke\"",
    "e2e:permissions": "playwright test --grep \"@permissions\"",
    "e2e:debug": "playwright test --debug",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report playwright-report",
    "install:browsers": "playwright install chromium firefox webkit",
    "sanitize:admin-artifacts": "node scripts/sanitize-admin-artifacts.mjs",
    "test:artifact-sanitizer": "node --test scripts/sanitize-admin-artifacts.test.mjs",
    "test": "pnpm run e2e",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@next/playwright": "16.3.2",
    "@playwright/test": "1.60.0",
    "@types/node": "20.17.30",
    "jszip": "3.10.1",
    "typescript": "7.0.2"
  }
}
