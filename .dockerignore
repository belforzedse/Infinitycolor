.git
.gitignore
.github
.cursor/*
!.cursor/docker/
!.cursor/docker/**
.turbo

node_modules
**/node_modules
.pnpm-store

*.env
.env
.env.*
# Root-only patterns above do not match nested paths, so local dev env files
# (apps/*/.env.local, apps/backend/db.env, ...) were being copied into images by
# `COPY . .`. CI never hit this because a fresh clone has no gitignored env
# files; a working-tree build does. Keep these nested rules.
**/*.env
**/.env
**/.env.*
!*.env.example
!**/*.env.example
!**/.env.example
*.log
coverage
**/coverage

**/.next
**/out
**/dist
**/build
**/.cache
**/.tmp
**/.strapi
**/.strapi-updater.json
**/.strapi-cloud.json
**/public/uploads

docs
load-test
agent-tools
