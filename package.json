{
  "name": "infinitycolor-monorepo",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:admin": "pnpm --filter @repo/admin build",
    "e2e": "turbo run e2e",
    "e2e:smoke": "turbo run e2e:smoke",
    "e2e:admin": "pnpm --filter @repo/e2e e2e:admin",
    "e2e:admin:smoke": "pnpm --filter @repo/e2e e2e:admin:smoke",
    "e2e:instant": "pnpm --filter @repo/e2e e2e:instant",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:admin": "pnpm --filter @repo/admin test",
    "check-types": "turbo run check-types",
    "doctor": "node scripts/dev-doctor.mjs",
    "seed:local": "node scripts/seed-local-demo.mjs",
    "onboarding:test": "node --test scripts/dev-doctor.test.mjs scripts/seed-local-demo.test.mjs"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "turbo": "latest"
  }
}
